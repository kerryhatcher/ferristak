# ---------------------------------------------------------------------------
# ferristak — local environment template. Copy to `.env` and fill in.
# `.env` is gitignored; never commit real credentials.
# ---------------------------------------------------------------------------

# Supabase Postgres connection string.
#
# Use the **Supavisor session pooler** (port 5432) for long-lived app servers:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# If you use the transaction pooler (port 6543) you MUST set
# DB_DISABLE_PREPARED_STATEMENTS=true (Supavisor transaction mode cannot keep
# server-side prepared statements).
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DB_MAX_CONNECTIONS=5
DB_DISABLE_PREPARED_STATEMENTS=false

# HMAC secret used to sign/verify API JWTs. Must be >= 32 bytes of entropy.
# Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-at-least-32-bytes-long
JWT_TTL_SECS=86400

# HTTP listener. Fly.io injects PORT (defaults to 8080).
BIND_ADDR=0.0.0.0:8080

# Run embedded sqlx migrations on boot. In production prefer the Fly
# release_command (`ferristak migrate`) and set this to false.
RUN_MIGRATIONS=true

# Comma-separated list of allowed browser origins. Empty = permissive (dev only).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

RUST_LOG=info,ferristak=debug,tower_http=debug
